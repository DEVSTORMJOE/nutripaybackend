# --- 🚀 CUSTOM CORS & HEADER INJECTION BEGIN ---
# This section forces LiteSpeed/Apache to allow CORS and pass Headers to Node.js
# <IfModule mod_headers.c>
#     Header set Access-Control-Allow-Origin "https://nutripay.co.ke"
#     Header set Access-Control-Allow-Credentials "true"
#     Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
#     Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control, Pragma, Expires, Cookie"
# </IfModule>

# Ensure Authorization header is passed to Node.js (needed for Login/Auth)
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
# --- 🚀 CUSTOM CORS & HEADER INJECTION END ---

